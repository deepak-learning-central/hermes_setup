# Hermes Setup - Git Ignore Rules

# Environment files - NEVER commit these!
.env
.env.*
*.env.local
*.env.production
# Exception: .env.example is tracked as a template (NOT ignored)
!.env.example

# Secrets and credentials
*.pem
*.key

# Encrypted Hermes config (web UI — never committed)
.hermes-config.enc

# Backup directory — local snapshot of old implementation
backup_*/

# Data directories
data/
models/
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Backup files
*.bak
*.backup
*~

# Test output
test-results/
htmlcov/